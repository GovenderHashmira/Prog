<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. See backup_rules.xml for why the encrypted prefs are excluded. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="edubridge_secure.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="edubridge_secure.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
    </device-transfer>
</data-extraction-rules>
