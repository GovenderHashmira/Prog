<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower.
     The encrypted prefs file must not be backed up: its Keystore key is not restored,
     so after a reinstall EncryptedSharedPreferences would crash trying to decrypt it. -->
<full-backup-content>
    <exclude domain="sharedpref" path="edubridge_secure.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs__.xml" />
</full-backup-content>
